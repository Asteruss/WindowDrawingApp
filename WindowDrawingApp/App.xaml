<Application x:Class="WindowDrawingApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WindowDrawingApp"
             
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <!--Стили-->
                <ResourceDictionary Source="/Styles/BorderStyles.xaml" />
                
                <!--Шаблоны-->
                <ResourceDictionary Source="/DataTemplates/BeamTemplate.xaml" />
                <ResourceDictionary Source="/DataTemplates/LightSpaceTemplate.xaml" />
                <ResourceDictionary Source="/DataTemplates/PictuteTemplate.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
