<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:model="clr-namespace:WindowDrawingApp.Models"
                    xmlns:behaviors="clr-namespace:WindowDrawingApp.Behaviors">

    <DataTemplate DataType="{x:Type model:Beam}">
        <Grid>
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SelectionBorderStyle}">

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=(behaviors:BeamVisual.Orientation), RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="Horizontal">
                                <Setter Property="Height" Value="{Binding Width}"/>
                                <Setter Property="Width" Value="{Binding Length}"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Path=(behaviors:BeamVisual.Orientation), RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="Vertical">
                                <Setter Property="Width" Value="{Binding Width}"/>
                                <Setter Property="Height" Value="{Binding Length}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" 
                              Command="{Binding DataContext.SelectNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                              CommandParameter="{Binding}"/>
                </Border.InputBindings>
            </Border>

            <Thumb Background="Transparent" FocusVisualStyle="{x:Null}" Opacity="0"
               behaviors:DragDeltaBehavior.DragCommand="{Binding DataContext.DragBeamCommand, RelativeSource={RelativeSource AncestorType=Window}}">

                <Thumb.Style>
                    <Style TargetType="Thumb">
                        <Style.Triggers>

                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Path=(behaviors:BeamVisual.Orientation), RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="Horizontal"/>

                                    <Condition Binding="{Binding Path=(behaviors:BeamVisual.ThumbSide), RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="End"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Height" Value="5"/>
                                <Setter Property="VerticalAlignment" Value="Bottom"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="Cursor" Value="SizeNS"/>
                            </MultiDataTrigger>

                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Path=(behaviors:BeamVisual.Orientation), RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="Horizontal"/>
                                    <Condition Binding="{Binding Path=(behaviors:BeamVisual.ThumbSide), RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="Start"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Height" Value="5"/>
                                <Setter Property="VerticalAlignment" Value="Top"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="Cursor" Value="SizeNS"/>
                            </MultiDataTrigger>

                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Path=(behaviors:BeamVisual.Orientation), RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="Vertical"/>
                                    <Condition Binding="{Binding Path=(behaviors:BeamVisual.ThumbSide), RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="End"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Width" Value="5"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Stretch"/>
                                <Setter Property="Cursor" Value="SizeWE"/>
                            </MultiDataTrigger>

                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Path=(behaviors:BeamVisual.Orientation), RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="Vertical"/>
                                    <Condition Binding="{Binding Path=(behaviors:BeamVisual.ThumbSide), RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" Value="Start"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Width" Value="5"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="VerticalAlignment" Value="Stretch"/>
                                <Setter Property="Cursor" Value="SizeWE"/>
                            </MultiDataTrigger>

                        </Style.Triggers>
                    </Style>
                </Thumb.Style>
            </Thumb>

        </Grid>
    </DataTemplate>
</ResourceDictionary>