<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:model="clr-namespace:WindowDrawingApp.Models"
                    xmlns:behaviors="clr-namespace:WindowDrawingApp.Behaviors"
                    xmlns:converters="clr-namespace:WindowDrawingApp.Converters">
    <converters:FrameTypeToVisibilityConverter x:Key="FrameVisibilityConverter"/>

    <DataTemplate DataType="{x:Type model:WindowFrame}">
        <Grid>
            <!--Вертикальная рама-->
            <Grid Visibility="{Binding FrameType, Converter={StaticResource FrameVisibilityConverter}, ConverterParameter=Vertical}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ContentControl Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                            Content="{Binding Left}"
                            behaviors:BeamVisual.Orientation="Vertical"
                            behaviors:BeamVisual.ThumbSide="End"/>

                <ContentControl Grid.Row="0" Grid.RowSpan="3" Grid.Column="2"
                            Content="{Binding Right}"
                            behaviors:BeamVisual.Orientation="Vertical"
                            behaviors:BeamVisual.ThumbSide="Start"/>

                <ContentControl Grid.Row="0" Grid.Column="1"
                            Content="{Binding Top}"
                            behaviors:BeamVisual.Orientation="Horizontal"
                            behaviors:BeamVisual.ThumbSide="End"/>

                <ContentControl Grid.Row="2" Grid.Column="1"
                            Content="{Binding Bottom}"
                            behaviors:BeamVisual.Orientation="Horizontal"
                            behaviors:BeamVisual.ThumbSide="Start"/>

                <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding RootSpace}"/>
            </Grid>
    
            <!--Горизонтальная рама-->
            <Grid Visibility="{Binding FrameType, Converter={StaticResource FrameVisibilityConverter}, ConverterParameter=Horizontal}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ContentControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                            Content="{Binding Top}"
                            behaviors:BeamVisual.Orientation="Horizontal"
                            behaviors:BeamVisual.ThumbSide="End"/>

                <ContentControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                            Content="{Binding Bottom}"
                            behaviors:BeamVisual.Orientation="Horizontal"
                            behaviors:BeamVisual.ThumbSide="Start"/>

                <ContentControl Grid.Row="1" Grid.Column="0"
                            Content="{Binding Left}"
                            behaviors:BeamVisual.Orientation="Vertical"
                            behaviors:BeamVisual.ThumbSide="End"/>

                <ContentControl Grid.Row="1" Grid.Column="2"
                            Content="{Binding Right}"
                            behaviors:BeamVisual.Orientation="Vertical"
                            behaviors:BeamVisual.ThumbSide="Start"/>

                <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding RootSpace}"/>
            </Grid>

        </Grid>
    </DataTemplate>
</ResourceDictionary>