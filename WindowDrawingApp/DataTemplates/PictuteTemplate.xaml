<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:model="clr-namespace:WindowDrawingApp.Models"
                    xmlns:behaviors="clr-namespace:WindowDrawingApp.Behaviors">
    <DataTemplate DataType="{x:Type model:Picture}">
        <Border
                Padding="5"
                Margin="5"
                Height="{Binding Height}"
                Width="{Binding Width}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{x:Null}"/>
            </Border.InputBindings>

            <ContentControl Content="{Binding WindowFrame}" Margin="5"/>
        </Border>
    </DataTemplate>
  
</ResourceDictionary>